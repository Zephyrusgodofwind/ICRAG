# No secret is required for retrieval-only operation.
IRISHCLINICALRAG_LOG_LEVEL=INFO
IRISHCLINICALRAG_DATA_DIR=data

# Optional OpenAI-compatible endpoint credential (including a RunPod-hosted endpoint).
# Keep generation.provider="extractive" in config when this is unset. Never commit keys.
IRISHCLINICALRAG_LLM_API_KEY=
